    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gadamaxi.BackendWork\Gadamaxi.BackendWork.csproj" />
    <ProjectReference Include="..\Gadamaxi.BackendWork.Sql\Gadamaxi.BackendWork.Sql.csproj" />
    <ProjectReference Include="..\Gadamaxi.BackendWork.Mongodb\Gadamaxi.BackendWork.Mongodb.csproj" />
  </ItemGroup>

